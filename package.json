{
  "name": "hgsmart-institucional",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional da Rede HG Smart — HTML estatico + JS vanilla + Tailwind CSS",
  "scripts": {
    "build": "tailwindcss -i ./assets/css/src.css -o ./assets/css/site.css --minify",
    "dev": "tailwindcss -i ./assets/css/src.css -o ./assets/css/site.css --watch",
    "serve": "node servidor-local.js",
    "banners": "node ferramentas/processar-banners.js",
    "seo": "node ferramentas/gerar-seo.js",
    "zap": "node ferramentas/inserir-zap.js index.html quem-somos.html catalogo.html servicos.html lojas/index.html",
    "paginas": "node ferramentas/gerar-paginas.js",
    "lojas": "node ferramentas/gerar-lojas.js",
    "mapa": "node ferramentas/gerar-mapa.js",
    "menu": "node ferramentas/aplicar-menu.js",
    "rodape": "node ferramentas/aplicar-rodape.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14"
  }
}
